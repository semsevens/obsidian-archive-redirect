{
	"name": "obsidian-archive-redirect",
	"version": "0.5.1",
	"description": "Archive remote URLs from markdown locally and serve from local cache on render.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
		"test": "node --experimental-strip-types --no-warnings --test 'tests/**/*.test.mts'"
	},
	"keywords": ["obsidian-plugin"],
	"author": "semsevens",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.0",
		"obsidian": "latest",
		"tslib": "^2.6.0",
		"typescript": "^5.3.0"
	}
}
